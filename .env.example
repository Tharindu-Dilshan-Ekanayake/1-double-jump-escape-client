# >>> FILL ME IN <<<
# The game slug from your Bloxity developer dashboard.
# Copy this file to `.env` (or `.env.local`) and replace the placeholder.
VITE_GAME_SLUG=1-double-jump-escape

# Bloxity endpoints. Leave these as-is unless you are running the portal locally.
# They MUST be set: without them the SDK repoints itself at localhost when it
# detects a dev server, and the login popup can never return a token.
VITE_BLOXITY_PORTAL_URL=https://bloxity.io
VITE_BLOXITY_API_URL=https://api.bloxity.io

# Bloxity Legion game id. When the game is hosted (not on localhost) players
# join through the Legion matchmaker for this game.
VITE_GAME_ID=1-double-jump-escape
# Optional: "preview" makes a page on your own domain use the dev backend.
# VITE_MATCHMAKER_VERSION=preview

# Colyseus game server (the 1-double-jump-escape-server repo). Defaults to
# ws://<this host>:2567 on localhost, which is what `npm run dev` there listens on.
# Setting it skips the matchmaker.
# VITE_SERVER_URL=ws://localhost:2567
